{
  "meta": {
    "id": "test_gamestage",
    "name": "测试-GameStage触发",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "需要 GameStages 模组支持。检测玩家是否有 example_stage 阶段",
    "triggers": [
      {
        "id": "has_stage",
        "type": "gamestage",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "stage": "example_stage"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": {
                  "dx": 0,
                  "dy": 2,
                  "dz": 0
                },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 10,
                "position": {
                  "dx": 0,
                  "dy": 5,
                  "dz": 0
                },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
