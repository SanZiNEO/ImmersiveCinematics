{
  "meta": {
    "id": "test_item_craft",
    "name": "测试-合成触发+多clip+morph",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "合成木棍时触发，测试两个 clip 之间的 morph 过渡",
    "triggers": [
      {
        "id": "craft_stick",
        "type": "item_craft",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "item": "minecraft:stick"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 4,
            "transition": "morph",
            "transition_duration": 1.5,
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 5, "dy": 2, "dz": 0 },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 4,
                "position": { "dx": 3, "dy": 3, "dz": -2 },
                "yaw": 30,
                "pitch": 5,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          },
          {
            "start_time": 4,
            "duration": 6,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 3, "dy": 3, "dz": -2 },
                "yaw": 30,
                "pitch": 5,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 6,
                "position": { "dx": -2, "dy": 4, "dz": -4 },
                "yaw": 60,
                "pitch": 10,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
