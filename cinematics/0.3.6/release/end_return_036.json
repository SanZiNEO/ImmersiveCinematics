{
  "meta": {
    "id": "end_return_036",
    "name": "重返起点 · 末地",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "96s 无音轨回归短片，进入末地 3 秒后自动播放、可重复触发。以「重返起点」为空间叙事：开场从西侧远望主岛，大半径环绕半圈（呼应 0.2.0 的第一个镜头）→ 镜头落回玩家身后，越过肩头凝视盘旋的末影龙，并缓缓推近、像举起望远镜对准它 → 随后飞离平台、越过岛缘驶向主岛 → 俯冲穿越黑曜石柱阵、下探中央基岩祭坛 → 以末影龙的视线建立坐标系，悬于龙背之上、随龙同行（骑龙视角）→ 最后掠出岛缘，退至远景回望。中段是一段「靠近—抵达—同行—离开」的旅程，镜头始终由玩家坐标与末影龙/末影人锚定，不依赖末影龙存活；俯冲段另开龙、末影人两个正面小窗。主岛中心 (0,64,0)，黑曜石平台约 (100,49,0)，改造地形需重新勘景。无命令、无音轨、无世界修改，玩家不获得无敌，建议创造模式录制。",
    "triggers": [
      {
        "id": "enter_end_return",
        "type": "dimension_change",
        "conditions": {
          "dimension": "minecraft:the_end"
        },
        "repeatable": true,
        "delay": 3
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "block_mob_ai": false,
    "hide_hud": true,
    "hide_arm": true,
    "hide_skip_hud": true,
    "suppress_bob": true,
    "suppress_distortion": true,
    "render_player_model": true,
    "pause_when_game_paused": true,
    "play_mode": "exclusive",
    "interruptible": false,
    "skippable": true,
    "hold_at_end": false
  },
