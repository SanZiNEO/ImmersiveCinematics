  "meta": {
    "id": "showcase_hue_curves",
    "name": "调色展示 05 · 六条 hue 曲线",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "一个功能一个脚本：六条 hue 曲线（DaVinci 曲线页口径，曲线组形态 b —— 六条都是 clip 级控制点数组，关键帧只控各自的混合强度 hv_h_strength / hv_s_strength / hv_l_strength / lv_s_strength / sv_s_strength / sv_l_strength，0~1、缺省 1、写回 0 = 该曲线淡出）。键是「进入 HSL 块时」的 hue / 亮度 / 饱和度（不受同帧标量 HSL 改动影响），目标是 hue / 饱和度 / 亮度之一：① HvH（hue→hue，色相分区旋转）② HvS（hue→饱和度）③ HvL（hue→亮度）④ LvS（亮度→饱和度，阴影褪色）⑤ SvS（饱和度→饱和度，只加强不太艳的部分）⑥ SvL（饱和度→亮度，只压暗已经很艳的部分）⑦ 六条同时全量，按固定顺序 HvH→HvS→HvL→LvS→SvS→SvL 叠加 ⑧ 六个强度全部归零还原。六条都在 HSL 块内、标量 HSL 之后、灰度之前生效。登录自动播放一次。",
    "triggers": [ { "id": "trg_login", "type": "login", "repeatable": false, "delay": 170, "conditions": {} } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
