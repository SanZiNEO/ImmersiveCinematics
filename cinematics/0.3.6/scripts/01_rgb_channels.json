{
  "meta": {
    "id": "showcase_rgb_channels",
    "name": "调色展示 01 · R/G/B 通道系数",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "一个功能一个脚本：R/G/B 通道系数（乘性，关键帧字段，缺省 0 = 无效果）。① R=-0.5 红通道减半；② R=-1 红通道归零（只剩 G+B）；③ G=-0.5 绿通道减半；④ B=+1 蓝通道双倍；⑤ 只留 R 通道（red=+1、green=-1、blue=-1）；⑥ 全部写回 0 → 画面逐位还原（证明全 0 = 恒等）。每段内参数 0 → 目标 → 0 渐入渐出，段间自然回到无调整；调色只写在 ADJUST 轨（master，作用于合成后整屏画面），只动 RGB、alpha 直通，透明度不在这里表达（走合成参数 opacity）。登录自动播放一次（login 触发 + repeatable=false）。",
    "triggers": [ { "id": "trg_login", "type": "login", "repeatable": false, "delay": 0, "conditions": {} } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
