{
  "meta": {
    "id": "test_h12_screen_layers_normal",
    "name": "H12 画面层普通模式",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "H12 夹具（普通模式）：hide_hud=false + screen_layer_mode=normal + screen_layers{hud.chat:false}。预期：只隐藏聊天，其余 HUD（快捷栏、准星、血量、经验条、Boss 血条、记分板、动作栏、标题、字幕、跳过提示）全部显示；不接管整帧，第三方前置事件自绘的界面照常出现。",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "screen_layer_mode": "normal",
    "screen_layers": { "hud.chat": false },
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 20,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 20,
            "transition": "cut",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 2, "dz": -6 }, "yaw": 0, "pitch": 10, "roll": 0, "fov": 70, "zoom": 1, "opacity": 1 },
              { "time": 20, "position": { "dx": 0, "dy": 2, "dz": -6 }, "yaw": 0, "pitch": 10, "roll": 0, "fov": 70, "zoom": 1, "opacity": 1 }
            ]
          }
        ]
      },
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 20,
            "layer_type": "subtitle",
            "text": "H12 normal：只隐藏聊天，其余 HUD 全部显示，本模组字幕显示",
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.10, "opacity": 1 },
              { "time": 20, "x": 0.5, "y": 0.10, "opacity": 1 }
            ]
          }
        ]
      }
    ]
  }
}
