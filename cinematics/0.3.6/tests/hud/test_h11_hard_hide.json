{
  "meta": {
    "id": "test_h11_hard_hide",
    "name": "H11 强硬隐藏与白名单",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "H11 夹具（仅 Forge）：hide_hud=true + hard_hide_hud=true，接管整段 HUD 后按白名单重画。hide_chat=true → 聊天层（分类 chat）在 hard 模式下同样不重画；hud_layers 写了 minecraft:chat_panel=false 也不生效——固定分类只读 hide_chat，hud_layers 不覆盖固定分类（这一条同时是「注册分类优先于 hud_layers」的回归项）。未注册 overlay 的隐式口子用临时测试 overlay 验证，见计划记录。",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": true,
    "hard_hide_hud": true,
    "hide_chat": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true,
    "hud_layers": { "minecraft:chat_panel": false }
  },
