{
  "meta": {
    "id": "test_adjust_blend",
    "name": "调色测试-混合模式作用于调整层",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "混合模式作用于调整层（= ADJUST 轨）：clip 级 blend_mode（normal / multiply / screen / soft_light / overlay，缺省 normal = 直替换 = 现状）+ 关键帧 blend_amount（0~1，缺省 1）把「调整层输出」（调色操作栈全部步骤算出的颜色）与「基画面」（原图）整体混合：c = mix(基画面, blend(基画面, 调整层输出, 模式), blend_amount)；blend_amount 写回 0 = 调整层整体透明（输出 = 基画面）。三段各演示一个模式：0~4s multiply（压暗、渐入）、4~8s screen（提亮、渐出）、8~12s soft_light（柔光、脉冲）。只动 RGB、alpha 逐位直通；只写在 ADJUST 轨（相机片段上写会被 validator 拦下）。",
    "triggers": [ { "id": "trg_login", "type": "login", "repeatable": false, "delay": 0, "conditions": {} } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 12,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 4,
            "layer_type": "subtitle",
            "text": "0~4s：blend_mode = multiply（压暗：调整层输出 × 基画面，blend_amount 0 → 1 渐入）",
            "x": 0.5,
            "y": 0.88,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.88, "opacity": 1 },
