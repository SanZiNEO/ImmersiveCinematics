{
  "meta": {
    "id": "test_camera_center_spawn",
    "name": "相机中心·刷怪门测试(夜晚停留)",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "超平坦/任意世界：相机固定相对玩家 -X 200 格、高 2 格停留 60s，t=0 设午夜/普通难度/开启刷怪并清空非玩家实体。相机离玩家 200 格（超出 128 配对半径）时服务端仍应按相机中心刷怪：日志 gateHit>0、attempts>0、spawned>0、localCapReject 偏低；对账 pairSeen 与客户端 total/r128。",
    "triggers": [
      { "id": "tcs_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_camera_center_multiclip"] }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
