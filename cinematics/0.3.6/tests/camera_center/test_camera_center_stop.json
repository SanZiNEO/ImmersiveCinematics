{
  "meta": {
    "id": "test_camera_center_stop",
    "name": "相机中心·停止释放测试",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "超平坦/任意世界：相机固定相对玩家 -X 200 格，t=5 执行 /icinematics stop（无参数 = 停止全体在线玩家的播放）提前结束。验收：服务端出现 release ... reason=stop ... remaining=0，且之后不再出现 script=test_camera_center_stop 的 state 行，也不应出现该脚本的 timeout 行。本脚本处于自动链中，停止后下一个 fixture（spectator）会自动开始，属预期。",
    "triggers": [
      { "id": "tct_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_camera_center_radius"] }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
