{
  "meta": {
    "id": "test_camera_center_high",
    "name": "相机中心·高空刷怪测试(俯视)",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "任意世界（超平坦最直观）：相机固定在玩家正上方 50 格、pitch=90 俯视 60s，t=0 设午夜/普通难度/清空非玩家实体。以超平坦为例：玩家脚底约 -60 → 相机 y 约 -10，虚拟玩家 y 必须等于相机 y（state anchorY==cam.y），地面刷怪点距相机约 50 格才过 24 格下限 → spawned>0；若锚点仍取地面（旧 groundY），刷怪点距锚点≈0 会被 24 格下限拒绝且落在 32 格消失半径内，spawned≈0。",
    "triggers": [
      { "id": "tch_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_camera_center_spawn"] }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
