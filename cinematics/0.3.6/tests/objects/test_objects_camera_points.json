{
  "meta": {
    "id": "test_objects_camera_points",
    "name": "对象格式-相机点源",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "新格式 CAMERA 两片段：段一 relative+world+空 position_origin（玩家激活位置）；段二 relative+base+facing_source=world（fwd/right）",
    "triggers": [ { "id": "trg_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" } } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 8,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 4,
            "objects": {
              "position_mode": { "value": "relative" },
              "position_space": { "value": "world" },
              "position_origin": { "value": "" },
              "position.x": { "keyframes": [ { "time": 0, "value": 4 }, { "time": 4, "value": 8 } ] },
              "position.z": { "keyframes": [ { "time": 0, "value": -6 }, { "time": 4, "value": -2 } ] }
            }
          },
          {
            "start_time": 4,
            "duration": 4,
            "objects": {
              "position_mode": { "value": "relative" },
              "position_space": { "value": "base" },
              "facing_source": { "value": "world" },
              "position.x": { "keyframes": [ { "time": 0, "value": 0 }, { "time": 4, "value": 2 } ] },
              "position.z": { "keyframes": [ { "time": 0, "value": 0 }, { "time": 4, "value": 5 } ] }
            }
          }
        ]
      }
    ]
  }
}
