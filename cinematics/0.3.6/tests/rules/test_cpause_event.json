{
  "meta": {
    "id": "test_cpause_event",
    "name": "C-pause 含 EVENT 暂停恢复",
    "author": "ImmersiveCinematics",
    "description": "C-pause 含 EVENT 的暂停 / 恢复实机夹具：CAMERA 片段 cam（20s，position.x 0→20、yaw 0→180 线性）在内容 6s 处由 r_pause（condition=time at 6，gate.at=6）执行 pause 并保持位置；r_resume 的 gate.at=5.5，判定源是不可达的 location（y=-100、radius=1，纯超时兜底），超时从门满足的 5.5s 起算 3.5s → 9.0s 真实时间由 on_timeout 执行 resume，实际暂停约 3s。EVENT 轨三条 command 记录：ev_4（t=4，pause 前，判「不重」）、ev_8（t=8，pause 后，判「不丢」）、ev_12（t=12，恢复后继续推进）。日志关键字 J1_EV_。",
    "triggers": [
      {
        "id": "trg_login",
        "type": "login",
        "repeatable": false,
        "delay": 0
      }
    ],
    "block_keyboard": false,
    "block_mouse": false,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "screen_layers": {
      "hud.hotbar": true,
      "hud.crosshair": true,
      "hud.health": true,
      "hud.experience": true,
      "hud.bossbar": true,
      "hud.chat": true,
      "hud.scoreboard": true,
      "hud.action_bar": true,
      "hud.title": true,
      "hud.subtitle": true,
      "hud.skip_prompt": true,
      "viewmodel": false,
      "view_bobbing": false,
      "screen_effects": false,
      "player_model": true,
      "status": true,
      "hotbar": true,
      "crosshair": true,
      "health": true,
      "bossbar": true,
      "chat": true,
      "scoreboard": true,
      "action_bar": true,
      "title": true,
      "subtitles": true
    }
  },
