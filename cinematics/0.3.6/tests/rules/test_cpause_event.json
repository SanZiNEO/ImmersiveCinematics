  },
  "rules": [
    {
      "id": "r_pause",
      "condition": {
        "type": "time",
        "at": 6
      },
      "actions": [
        {
          "type": "pause"
        }
      ],
      "policy": {
        "once": true
      }
    },
    {
      "id": "r_resume",
      "condition": {
        "type": "location",
        "position": {
          "x": 0,
          "y": -100,
          "z": 0
        },
        "radius": 1
      },
      "actions": [
        {
          "type": "resume"
        }
      ],
      "policy": {
        "timeout": 3.5,
        "on_timeout": [
          {
            "type": "resume"
          }
        ]
      }
    }
  ],
  "rule_bindings": [
    {
      "id": "b_pause",
      "rule": "r_pause",
      "clip": "cam",
      "gate": {
        "at": 6
      },
      "control": "observe"
    },
    {
      "id": "b_resume",
      "rule": "r_resume",
      "clip": "cam",
      "gate": {
        "at": 5.5
      },
      "control": "observe"
    }
  ]
}
