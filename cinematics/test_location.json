{
  "meta": {
    "id": "test_location",
    "name": "测试-位置触发+FOV+zoom推拉",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "站在坐标原点附近触发，测试 fov 从 70 变到 30（望远）+ zoom 同步变化",
    "triggers": [
      {
        "id": "enter_spawn",
        "type": "location",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "corner1": { "x": -50, "y": -64, "z": -50 },
          "corner2": { "x": 50, "y": 320, "z": 50 }
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 0, "dy": 2, "dz": 0 },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 5,
                "position": { "dx": 0, "dy": 3, "dz": -10 },
                "yaw": 0,
                "pitch": 5,
                "roll": 0,
                "fov": 50,
                "zoom": 1.5
              },
              {
                "time": 10,
                "position": { "dx": 0, "dy": 4, "dz": -20 },
                "yaw": 0,
                "pitch": 10,
                "roll": 0,
                "fov": 30,
                "zoom": 2
              }
            ]
          }
        ]
      }
    ]
  }
}
