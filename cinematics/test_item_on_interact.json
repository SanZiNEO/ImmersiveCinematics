{
  "meta": {
    "id": "test_item_on_interact",
    "name": "测试-物品交互触发+loop",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "手持木棍右键熔炉时触发，测试 loop 循环",
    "triggers": [
      {
        "id": "stick_on_furnace",
        "type": "item_on_interact",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "item": "minecraft:stick",
          "target": "minecraft:furnace"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": true,
            "loop_count": 2,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 2, "dy": 1, "dz": 0 },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 3,
                "position": { "dx": 0, "dy": 2, "dz": -2 },
                "yaw": 30,
                "pitch": -5,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 7,
                "position": { "dx": -2, "dy": 1, "dz": 2 },
                "yaw": -30,
                "pitch": 5,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 10,
                "position": { "dx": 2, "dy": 1, "dz": 0 },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
