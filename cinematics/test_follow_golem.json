              { "time": 30, "position": { "dx": 0, "dy": 6, "dz": -8 }, "follow": "entity", "follow_selector": "@e[type=minecraft:iron_golem]", "look_at": "entity", "look_at_selector": "@e[type=minecraft:iron_golem]", "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 }
            ]
