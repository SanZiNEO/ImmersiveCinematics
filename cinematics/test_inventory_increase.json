{
  "meta": {
    "id": "test_inventory_increase",
    "name": "测试-物品增加触发+pitch",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "获得圆石时触发，测试 pitch 从 -30° 到 30° 摇摆",
    "triggers": [
      {
        "id": "got_cobblestone",
        "type": "inventory",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "items": ["minecraft:cobblestone"],
          "change": "increase"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 5, "dy": 2, "dz": 5 },
                "yaw": 45,
                "pitch": -30,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 5,
                "position": { "dx": 0, "dy": 4, "dz": 0 },
                "yaw": 45,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 10,
                "position": { "dx": -5, "dy": 2, "dz": -5 },
                "yaw": 45,
                "pitch": 30,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
