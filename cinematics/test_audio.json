{
  "meta": {
    "id": "test_audio",
    "name": "AUDIO 轨道测试",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "测试 AUDIO 轨道：OGG 播放、音量关键帧、淡入淡出",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false
  },
  "timeline": {
    "total_duration": 20.0,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 20,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 3, "dy": 2, "dz": -3 },
                "yaw": 0,
                "pitch": -5,
                "roll": 0,
                "fov": 70,
                "zoom": 1.0
              },
              {
                "time": 20,
                "position": { "dx": -3, "dy": 2, "dz": 3 },
                "yaw": 180,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1.0
              }
            ]
          }
        ]
      },
      {
        "type": "AUDIO",
        "clips": [
          {
            "start_time": 0,
            "duration": 20,
            "sound": "test_background.ogg",
            "source": "file",
            "volume": 1.0,
            "pitch": 1.0,
            "loop": false,
            "fade_in": 2.0,
            "fade_out": 3.0,
            "attenuation": "linear",
            "position_mode": "relative",
            "keyframes": [
              { "time": 0,  "volume": 1.0, "x": 0, "y": 0, "z": 0 },
              { "time": 10, "volume": 0.5, "x": 5, "y": 2, "z": 0 },
              { "time": 20, "volume": 1.0, "x": 0, "y": 0, "z": 0 }
            ]
          }
        ]
      }
    ]
  }
}
