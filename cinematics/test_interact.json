{
  "meta": {
    "id": "test_interact",
    "name": "测试-交互触发+pitch俯仰",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "右键工作台触发，测试 pitch 从 0° 到 90° 俯视",
    "triggers": [
      {
        "id": "use_crafting_table",
        "type": "block_interact",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "target": "minecraft:crafting_table"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 2, "dy": 1, "dz": 0 },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1,
                "dof": 0
              },
              {
                "time": 5,
                "position": { "dx": 0, "dy": 5, "dz": 0 },
                "yaw": 0,
                "pitch": 45,
                "roll": 0,
                "fov": 70,
                "zoom": 1,
                "dof": 0
              },
              {
                "time": 10,
                "position": { "dx": -2, "dy": 10, "dz": 0 },
                "yaw": 0,
                "pitch": 90,
                "roll": 0,
                "fov": 70,
                "zoom": 1,
                "dof": 0
              }
            ]
          }
        ]
      }
    ]
  }
}
