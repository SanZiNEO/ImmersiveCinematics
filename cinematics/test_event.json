{
  "meta": {
    "id": "test_event",
    "name": "EVENT 轨道测试",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "测试 EVENT keyframe 驱动的事件触发，每5秒触发一次命令",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false
  },
  "timeline": {
    "total_duration": 30.0,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 30,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 5, "dy": 2, "dz": -5 },
                "yaw": 135,
                "pitch": -10,
                "roll": 0,
                "fov": 70,
                "zoom": 1.0,
                "dof": 0
              },
              {
                "time": 15,
                "position": { "dx": -5, "dy": 3, "dz": 5 },
                "yaw": -45,
                "pitch": 5,
                "roll": 0,
                "fov": 70,
                "zoom": 1.0,
                "dof": 0
              },
              {
                "time": 30,
                "position": { "dx": 0, "dy": 2, "dz": 8 },
                "yaw": 0,
                "pitch": -5,
                "roll": 0,
                "fov": 75,
                "zoom": 1.0,
                "dof": 0
              }
            ]
          }
        ]
      },
      {
        "type": "EVENT",
        "clips": [
          {
            "start_time": 0,
            "duration": 30,
            "event_type": "command",
            "keyframes": [
              { "time": 0,   "event_type": "command", "command": "say [EVENT] 脚本开始！第0秒" },
              { "time": 5,   "event_type": "command", "command": "say [EVENT] 第5秒 - 镜头正在移动" },
              { "time": 10,  "event_type": "command", "command": "say [EVENT] 第10秒 - 继续移动" },
              { "time": 15,  "event_type": "command", "command": "say [EVENT] 第15秒 - 镜头转向" },
              { "time": 20,  "event_type": "command", "command": "say [EVENT] 第20秒 - 快结束了" },
              { "time": 25,  "event_type": "command", "command": "say [EVENT] 第25秒 - 即将完成" },
              { "time": 30,  "event_type": "command", "command": "say [EVENT] 第30秒 - 脚本结束！" }
            ]
          }
        ]
      }
    ]
  }
}
