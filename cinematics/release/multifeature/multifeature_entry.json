{
  "meta": {
    "id": "multifeature_entry",
    "name": "多功能并行展示 · 入口（导演实例）",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "0.3.6 多功能一次性展示的入口/导演实例：本身没有 CAMERA 轨（不产生画面 lane），一次性把 0.3.6 的多种能力放在同一条时间线上——① EVENT 轨拉起 3 个画面实例（multifeature:multifeature_left / _right / _pip，需权限 2，命令失败静默）；② LETTERBOX 轨开场拉开 / 收尾合上 2.35 宽银幕；③ OVERLAY 字幕轨三段说明；④ AUDIO 轨三段原版音效（无外部资源依赖）；⑤ ADJUST 轨 master 调色关键帧动画（暖 → 绿 → 灰 → 冷 → 品红，作用于整屏）。macro_loop 2 圈 × 30s，播完自动结束。触发：入口默认由 quadrant_demo 播放完成后自动接续（any + script_completed 前置链，无需权限）；单独安装本组时用 /icinematics play multifeature:multifeature_entry 手动播放（脚本放在 <游戏目录>/immersive_cinematics/scripts/multifeature/ 下时命令 id 才是 multifeature:xxx；平铺复制则用 /icinematics play multifeature_entry）。",
    "triggers": [
      {
        "id": "after_quadrant_demo",
        "type": "any",
        "repeatable": false,
        "delay": 0.0,
        "conditions": {
          "list": [
            { "type": "script_completed", "conditions": { "script": "quadrant_demo" } }
          ]
        }
      }
    ],
    "dimension": "",
    "block_keyboard": false,
    "block_mouse": false,
    "block_mob_ai": false,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "hide_skip_hud": false,
    "render_player_model": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "macro_loop": true,
    "macro_loop_count": 2,
    "macro_loop_mode": "repeat",
    "priority": 0
  },
