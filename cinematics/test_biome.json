{
  "meta": {
    "id": "test_biome",
    "name": "测试-群系触发+yaw旋转",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "玩家进入平原群系时触发，测试 yaw 从 0° 到 360° 旋转一周",
    "triggers": [
      {
        "id": "enter_plains",
        "type": "biome",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "biome": "minecraft:plains"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "position_mode": "relative",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 5, "dy": 3, "dz": 0 },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1,
                "dof": 0
              },
              {
                "time": 5,
                "position": { "dx": 0, "dy": 5, "dz": 0 },
                "yaw": 180,
                "pitch": -10,
                "roll": 0,
                "fov": 70,
                "zoom": 1,
                "dof": 0
              },
              {
                "time": 10,
                "position": { "dx": -5, "dy": 3, "dz": 0 },
                "yaw": 360,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1,
                "dof": 0
              }
            ]
          }
        ]
      }
    ]
  }
}
