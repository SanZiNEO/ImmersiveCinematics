{
  "meta": {
    "id": "test_camera_smooth_motion",
    "name": "相机测试-帧间平滑（tick/render 解耦）",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "校验用：六参数全程严格单调的匀速运动（段 1 线性、解析可核对）+ 贝塞尔曲线路径段（段 2），用于实机抽验「相机参数随渲染帧连续、无 20Hz 台阶」（0.3.6 B17，plans/0.3.6/temporal-interpolation.md §7.1/§8.1）。六参数在运动段内两两相邻渲染帧的值都不相同——若相机改由逻辑 tick（20Hz / 50ms）驱动，转储里会出现「连续若干帧完全相同 + 每 50ms 一次跳变」的平台，本 fixture 即为此现象的判据；不写 motion_*（默认关），避免运动模型掩盖台阶",
    "triggers": [ { "id": "trg_login", "type": "login", "repeatable": false, "delay": 0 } ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 20,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 12,
            "transition": "cut",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 0, "dz": 0 }, "yaw": -90, "pitch": -6, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 12, "position": { "dx": 48, "dy": 12, "dz": -24 }, "yaw": 0, "pitch": 18, "roll": 6, "fov": 58, "zoom": 1.3 }
            ]
          },
          {
            "start_time": 12,
            "duration": 8,
            "transition": "cut",
            "loop": false,
            "curve": {
              "type": "bezier",
              "control_points": [
                { "dx": 12, "dy": 20, "dz": -20 },
                { "dx": 30, "dy": -16, "dz": 16 }
              ]
            },
            "keyframes": [
              { "time": 0, "position": { "dx": 48, "dy": 12, "dz": -24 }, "yaw": 0, "pitch": 18, "roll": 6, "fov": 58, "zoom": 1.3 },
              { "time": 8, "position": { "dx": 72, "dy": 4, "dz": -8 }, "yaw": 90, "pitch": 42, "roll": 16, "fov": 50, "zoom": 1.5 }
            ]
          }
        ]
      }
    ]
  }
}
