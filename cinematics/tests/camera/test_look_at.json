{
  "meta": {
    "id": "test_look_at",
    "name": "固定机位注视测试",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "关键帧级 look_at 测试：相机固定在触发点北侧高位（position 相对偏移），关键帧 look_at=entity(@p) 注视锁定玩家（目标点=玩家渲染帧插值位置+半高）；屏蔽 HUD，键鼠不屏蔽，玩家移动相机原地转头跟随",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": true,
    "skippable": true,
    "hold_at_end": false
  },
  "timeline": {
    "total_duration": 30,
    "tracks": [
      {
        "type": "CAMERA",
        "id": "camera_1",
        "clips": [
          {
            "start_time": 0,
            "duration": 30,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 4, "dz": -8 }, "look_at": "entity", "look_at_selector": "@p", "yaw": 0, "pitch": -10, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 30, "position": { "dx": 0, "dy": 4, "dz": -8 }, "look_at": "entity", "look_at_selector": "@p", "yaw": 0, "pitch": -10, "roll": 0, "fov": 70, "zoom": 1 }
            ]
          }
        ]
      }
    ]
  }
}
