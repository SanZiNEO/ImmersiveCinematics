{
  "meta": {
    "id": "test_camera_modifier_nosuppress",
    "name": "相机测试-Modifier不抑制",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "suppress 关（显式 false）：关键帧 yaw 0→90 + 缺省模式（yaw 属偏移类 → ADD）的 yaw 45 → 合成后 45→135；与 test_camera_modifier_suppress 除该字段外完全相同（A/B 对照）",
    "triggers": [ { "id": "trg_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_camera_modifier_replace"] } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 8,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "layer_type": "subtitle",
            "text": "测试: suppress_modifiers=false | 关键帧 yaw 0→90 再叠加 +45 = 45→135（Modifier 生效）",
            "x": 0.5,
            "y": 0.5,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.5, "opacity": 1 },
              { "time": 8, "x": 0.5, "y": 0.5, "opacity": 1 }
            ]
          }
        ]
      },
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "transition": "cut",
            "loop": false,
            "suppress_modifiers": false,
            "modifier": {
              "channels": ["yaw"],
              "yaw": 45
            },
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 8, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 90, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 }
            ]
          }
        ]
      }
    ]
  }
}
