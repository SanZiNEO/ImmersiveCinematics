{
  "meta": {
    "id": "test_dimension_change",
    "name": "测试-维度触发+transition morph",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "进入下界时触发，测试 morph 过渡 + transition_duration 效果",
    "triggers": [
      {
        "id": "enter_nether",
        "type": "dimension_change",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "dimension": "minecraft:the_nether"
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 4,
            "transition": "morph",
            "transition_duration": 1,
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": {
                  "dx": 3,
                  "dy": 2,
                  "dz": 0
                },
                "yaw": 0,
                "pitch": 0,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 4,
                "position": {
                  "dx": 0,
                  "dy": 3,
                  "dz": -3
                },
                "yaw": 90,
                "pitch": 5,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          },
          {
            "start_time": 4,
            "duration": 6,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": {
                  "dx": 0,
                  "dy": 3,
                  "dz": -3
                },
                "yaw": 90,
                "pitch": 5,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 6,
                "position": {
                  "dx": -3,
                  "dy": 5,
                  "dz": 0
                },
                "yaw": 180,
                "pitch": 15,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
