{
  "meta": {
    "id": "test_camera_transition_params",
    "name": "相机测试-过渡分参数/曲线/打断",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "分参数过渡（hold/cut/逐通道时长）+ 权重曲线 + 打断（blend 续接 / snap 硬切）：clip1 的 zoom 时长 4s 使其窗口为 [2,6)，clip2 的时长 4s 使其窗口为 [3,7) —— 两窗重叠，故 clip2 声明的 snap 在 t=3 实际触发（硬切到 clip3）",
    "triggers": [ { "id": "trg_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_camera_transition_morph"] } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "layer_type": "subtitle",
            "text": "测试: test_camera_transition_params | 功能: 分参数 + 曲线 + 打断(snap) | 触发: biome自动",
            "x": 0.5,
            "y": 0.5,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.5, "opacity": 1 },
              { "time": 10, "x": 0.5, "y": 0.5, "opacity": 1 }
            ]
          }
        ]
      },
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 4,
            "transition": "morph",
            "transition_duration": 1,
            "transition_curve": { "type": "smoothstep" },
            "transition_interrupt": "blend",
            "transition_params": {
              "roll": { "mode": "hold" },
              "fov": { "mode": "cut" },
              "zoom": { "mode": "blend", "duration": 4, "curve": { "type": "ease_in_out" } }
            },
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 0, "pitch": 5, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 4, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 0, "pitch": 5, "roll": 0, "fov": 70, "zoom": 1 }
            ]
          },
          {
            "start_time": 4,
            "duration": 1,
            "transition": "morph",
            "transition_duration": 4,
            "transition_interrupt": "snap",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 10, "dy": 3, "dz": 0 }, "yaw": 90, "pitch": 5, "roll": 0, "fov": 70, "zoom": 2 },
              { "time": 1, "position": { "dx": 10, "dy": 3, "dz": 0 }, "yaw": 90, "pitch": 5, "roll": 0, "fov": 70, "zoom": 2 }
            ]
          },
          {
            "start_time": 5,
            "duration": 5,
            "transition": "cut",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 20, "dy": 3, "dz": 0 }, "yaw": 180, "pitch": 5, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 5, "position": { "dx": 20, "dy": 3, "dz": 0 }, "yaw": 180, "pitch": 5, "roll": 0, "fov": 70, "zoom": 1 }
            ]
          }
        ]
      }
    ]
  }
}
