{
  "meta": {
    "id": "test_structure_village",
    "name": "测试-结构触发+dynamic yaw",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "玩家进入村庄范围时触发，测试 yaw/pitch 混合变化",
    "triggers": [
      {
        "id": "enter_village",
        "type": "structure",
        "repeatable": false,
        "delay": 0.5,
        "conditions": {
          "structure": "village",
          "radius": 32
        }
      }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": true,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": false,
    "hide_chat": null,
    "hide_scoreboard": null,
    "hide_action_bar": null,
    "hide_title": null,
    "hide_subtitles": null,
    "hide_hotbar": null,
    "hide_crosshair": null,
    "hide_bossbar": null,
    "hide_skip_hud": null
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": {
                  "dx": 3,
                  "dy": 2,
                  "dz": -3
                },
                "yaw": 45,
                "pitch": -5,
                "roll": 0,
                "fov": 80,
                "zoom": 0.8
              },
              {
                "time": 5,
                "position": {
                  "dx": 0,
                  "dy": 4,
                  "dz": 0
                },
                "yaw": 0,
                "pitch": 15,
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 10,
                "position": {
                  "dx": -3,
                  "dy": 2,
                  "dz": 3
                },
                "yaw": -45,
                "pitch": -5,
                "roll": 0,
                "fov": 60,
                "zoom": 1.2
              }
            ]
          }
        ]
      }
    ]
  }
}
