{
  "meta": {
    "id": "test_follow",
    "name": "跟拍跟随测试",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "关键帧级 follow 跟拍测试：关键帧 follow=entity(@p)，position 的 dx/dy/dz 即相对玩家实时位置的偏移（上4格/南5格），每帧更新跟随；朝向固定（无 look_at，走 yaw/pitch 角度插值）；只屏蔽准星与手臂，键鼠不屏蔽，玩家可自由移动操控",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_crosshair": true,
    "hide_arm": true,
    "skippable": true,
    "hold_at_end": false
  },
  "timeline": {
    "total_duration": 30,
    "tracks": [
      {
        "type": "CAMERA",
        "id": "camera_1",
        "clips": [
          {
            "start_time": 0,
            "duration": 30,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 4, "dz": -5 }, "follow": "entity", "follow_selector": "@p", "yaw": 0, "pitch": -10, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 30, "position": { "dx": 0, "dy": 4, "dz": -5 }, "follow": "entity", "follow_selector": "@p", "yaw": 0, "pitch": -10, "roll": 0, "fov": 70, "zoom": 1 }
            ]
          }
        ]
      }
    ]
  }
}
