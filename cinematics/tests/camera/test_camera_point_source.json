{
  "meta": {
    "id": "test_camera_point_source",
    "name": "相机测试-统一点源(连线端点/facing_target)",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "yaw_base/pitch_base=line 的两个端点与 facing_target 用统一点源。0-3s 坐标→坐标；3-6s 玩家激活位置→方块(东侧黑曜石)；6-8s facing_target=方块(基准空间偏移 fwd=-6)；8-10s 实体选择器→玩家激活位置",
    "triggers": [
      { "id": "trg_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_trigger_login"] }
    ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "layer_type": "subtitle",
            "text": "测试: test_camera_point_source | 0-3s 连线端点=坐标(0,64,0)→(0,64,10) 看向南 | 3-6s 端点=player→block(玩家东侧黑曜石) 看向东 | 6-8s facing_target=block 基准空间偏移 fwd=-6 | 8-10s 端点=实体选择器→player",
            "x": 0.5,
            "y": 0.5,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.5, "opacity": 1 },
              { "time": 10, "x": 0.5, "y": 0.5, "opacity": 1 }
