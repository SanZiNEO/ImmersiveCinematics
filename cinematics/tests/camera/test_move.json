{
  "meta": {
    "id": "test_move",
    "name": "玩家移动控制演示（EVENT position 折线）",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "玩家从触发点走向东15格、再转向北15格（折线）；相机固定高点用 look_at 追玩家。脚本播完玩家停在最后目标。",
    "triggers": [
      { "id": "tm_login", "type": "login", "repeatable": false, "delay": 0, "conditions": {} }
    ],
    "block_keyboard": true,
    "block_mouse": true,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 12,
    "tracks": [
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 12,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              {
                "time": 0,
                "position": { "dx": 8, "dy": 5, "dz": -10 },
                "look_at": "entity",
                "look_at_selector": "@p",
                "roll": 0,
                "fov": 70,
                "zoom": 1
              },
              {
                "time": 12,
                "position": { "dx": 8, "dy": 5, "dz": -10 },
                "look_at": "entity",
                "look_at_selector": "@p",
                "roll": 0,
                "fov": 70,
                "zoom": 1
              }
            ]
          }
        ]
      },
      {
        "type": "EVENT",
        "clips": [
          {
            "start_time": 0,
            "duration": 12,
            "event_type": "command",
            "keyframes": [
              { "time": 0, "event_type": "command", "position": { "dx": 0, "dz": 0 }, "command": "say [移动] 起点：玩家从当前位置出发" },
              { "time": 4, "event_type": "command", "position": { "dx": 15, "dz": 0 }, "command": "say [移动] 第4秒目标：东15格（第一段直线）" },
              { "time": 8, "event_type": "command", "position": { "dx": 15, "dz": 15 }, "command": "say [移动] 第8秒目标：再向北15格（折线第二段）" },
              { "time": 12, "event_type": "command", "position": { "dx": 15, "dz": 15 }, "command": "say [移动] 结束：玩家应停在 (15,15) 附近" }
            ]
          }
        ]
      }
    ]
  }
}
