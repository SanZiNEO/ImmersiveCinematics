            "loop_mode": "repeat",
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 2, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 30, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 }
