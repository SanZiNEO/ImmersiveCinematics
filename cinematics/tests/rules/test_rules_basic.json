{
  "meta": {
    "id": "test_rules_basic",
    "name": "规则测试-基础层",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "clip.rules 基础层：一条 if（location 条件 → camera_set，mode enter）+ 一条 until（time 条件 → goto_clip，timeout 20s → on_timeout exit）；本任务只落数据链与挂起时钟，判定源 / 动作集待 C6-2 / C6-3",
    "triggers": [ { "id": "trg_login", "type": "login", "repeatable": false, "delay": 0, "conditions": {} } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 12,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 12,
            "layer_type": "subtitle",
            "text": "测试: clip.rules 基础层 | if location → camera_set | until time 12s → goto_clip（timeout 20s → exit）",
            "x": 0.5,
            "y": 0.5,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.5, "opacity": 1 },
              { "time": 12, "x": 0.5, "y": 0.5, "opacity": 1 }
            ]
          }
        ]
      },
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 12,
            "transition": "cut",
            "loop": false,
            "rules": [
              {
                "if": { "type": "location", "corner1": { "x": 100, "y": 60, "z": -200 }, "corner2": { "x": 120, "y": 80, "z": -180 } },
                "do": [ { "type": "camera_set", "position": [110, 75, -190], "blend": 1.5 } ],
                "mode": "enter"
              },
              {
                "until": { "type": "time", "at": 12.0 },
                "do": [ { "type": "goto_clip", "clip": "clip_b" } ],
                "timeout": 20,
                "on_timeout": [ { "type": "exit" } ]
              }
            ],
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 12, "position": { "dx": 0, "dy": 3, "dz": 0 }, "yaw": 45, "pitch": -5, "roll": 0, "fov": 65, "zoom": 1 }
            ]
          }
        ]
      }
    ]
  }
}
