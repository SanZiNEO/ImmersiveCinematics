{
  "meta": {
    "id": "test_audio_wav",
    "name": "音频测试-WAV",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "WAV 文件播放（当前为静音资源，验证解码/播放链路）",
    "triggers": [ { "id": "trg_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" }, "requires": ["test_audio_volume"] } ],
    "listener": "camera",
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 10,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "layer_type": "subtitle",
            "text": "测试: test_audio_wav | 功能: WAV 播放 | 触发: biome自动",
            "x": 0.5,
            "y": 0.5,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.5, "opacity": 1 },
              { "time": 10, "x": 0.5, "y": 0.5, "opacity": 1 }
            ]
          }
        ]
      },
      {
        "type": "EVENT",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "event_type": "command",
            "keyframes": [
              { "time": 0, "event_type": "command", "command": "summon minecraft:zombie ~300 ~ ~" },
              { "time": 0.01, "event_type": "command", "command": "summon minecraft:sheep ~ ~ ~" }
            ]
          }
        ]
      },
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "transition": "cut",
            "interpolation": "linear",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 300, "dy": 20, "dz": 0 }, "yaw": 90, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 },
              { "time": 10, "position": { "dx": 300, "dy": 20, "dz": 0 }, "yaw": 90, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1 }
            ]
          }
        ]
      },
      {
        "type": "AUDIO",
        "clips": [
          {
            "start_time": 0,
            "duration": 10,
            "sound": "test_silence.wav",
            "source": "file",
            "category": "ambient",
            "volume": 1,
            "pitch": 1,
            "loop": false,
            "fade_in": 0.5,
            "fade_out": 0.5,
            "attenuation": "linear",
            "position_mode": "relative",
            "keyframes": [
              { "time": 0, "volume": 1, "x": 300, "y": 0, "z": 0 }
            ]
          }
        ]
      }
    ]
  }
}
