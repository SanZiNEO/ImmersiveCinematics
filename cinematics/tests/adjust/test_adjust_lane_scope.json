{
  "meta": {
    "id": "test_adjust_lane_scope",
    "name": "调色测试-lane级作用域",
    "author": "ImmersiveCinematics",
    "version": 3,
    "description": "lane 级调色：2 条 CAMERA 轨各占半屏 + 各自绑定一条 lane 级 ADJUST（lane 0 红通道压没、lane 1 蓝通道压没）+ 1 条 master ADJUST（暖色调，验证共存）",
    "triggers": [ { "id": "trg_login", "type": "biome", "repeatable": false, "delay": 0, "conditions": { "biome": "*" } } ],
    "block_keyboard": false,
    "block_mouse": false,
    "hide_hud": false,
    "hide_arm": true,
    "suppress_bob": true,
    "pause_when_game_paused": true,
    "interruptible": true,
    "skippable": true,
    "hold_at_end": false,
    "render_player_model": true
  },
  "timeline": {
    "total_duration": 8,
    "tracks": [
      {
        "type": "OVERLAY",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "layer_type": "subtitle",
            "text": "测试: test_adjust_lane_scope | 左半屏 lane 0 = red 0→-1 | 右半屏 lane 1 = blue 0→-1 | 全场 master = temperature 0→0.4",
            "x": 0.5,
            "y": 0.5,
            "z_index": 100,
            "keyframes": [
              { "time": 0, "x": 0.5, "y": 0.5, "opacity": 1 },
              { "time": 8, "x": 0.5, "y": 0.5, "opacity": 1 }
            ]
          }
        ]
      },
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "transition": "cut",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 3, "dz": -8 }, "look_at": "entity", "look_at_selector": "@p", "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1, "opacity": 1, "dest": { "x": 0, "y": 0, "w": 0.5, "h": 1 } },
              { "time": 8, "position": { "dx": 4, "dy": 3, "dz": -8 }, "look_at": "entity", "look_at_selector": "@p", "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1, "opacity": 1, "dest": { "x": 0, "y": 0, "w": 0.5, "h": 1 } }
            ]
          }
        ]
      },
      {
        "type": "CAMERA",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "transition": "cut",
            "loop": false,
            "keyframes": [
              { "time": 0, "position": { "dx": 0, "dy": 3, "dz": 8 }, "look_at": "entity", "look_at_selector": "@p", "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1, "opacity": 1, "dest": { "x": 0.5, "y": 0, "w": 0.5, "h": 1 } },
              { "time": 8, "position": { "dx": -4, "dy": 3, "dz": 8 }, "look_at": "entity", "look_at_selector": "@p", "yaw": 0, "pitch": 0, "roll": 0, "fov": 70, "zoom": 1, "opacity": 1, "dest": { "x": 0.5, "y": 0, "w": 0.5, "h": 1 } }
            ]
          }
        ]
      },
      {
        "type": "ADJUST",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "scope": "lane",
            "lane": 0,
            "keyframes": [
              { "time": 0, "red": 0 },
              { "time": 4, "red": -1 },
              { "time": 8, "red": -1 }
