          }
        ]
      },
      {
        "type": "ADJUST",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "scope": "master",
            "keyframes": [
              { "time": 0, "temperature": 0 },
              { "time": 4, "temperature": 0.4 },
