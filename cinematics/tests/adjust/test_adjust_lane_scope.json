          }
        ]
      },
      {
        "type": "ADJUST",
        "clips": [
          {
            "start_time": 0,
            "duration": 8,
            "scope": "lane",
            "lane": 1,
            "keyframes": [
              { "time": 0, "blue": 0 },
              { "time": 4, "blue": -1 },
              { "time": 8, "blue": -1 }
