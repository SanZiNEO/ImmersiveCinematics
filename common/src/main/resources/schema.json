{
  "version": 1,
  "track_types": {
    "CAMERA": {
      "clips": {
        "transition": { "type": "enum", "values": ["cut", "morph"], "default": "cut" },
        "transition_duration": { "type": "float", "default": 0.5 },
        "interpolation": { "type": "enum", "values": ["linear", "smooth"], "default": "linear" },
        "curve": { "type": "bezier_curve" },
        "dimension": { "type": "string", "default": "" },
        "loop": { "type": "bool", "default": false },
        "loop_count": { "type": "int", "default": -1 },
        "loop_mode": { "type": "enum", "values": ["repeat", "pingpong"], "default": "repeat" },
        "cam_breath_enabled": { "type": "bool", "default": false },
        "cam_breath_intensity": { "type": "float", "default": 0.05 },
        "cam_breath_seed": { "type": "int", "default": 0 },
        "cam_breath_type": { "type": "enum", "values": ["perlin", "perlin_axis", "sine", "trauma"], "default": "perlin" },
        "cam_breath_speed": { "type": "float", "default": 1.0 },
        "cam_breath_trauma": { "type": "float", "default": 1.0 },
        "cam_breath_decay": { "type": "float", "default": 0.5 }
      },
      "keyframes": {
        "position": { "type": "position", "required": true },
        "position_mode": { "type": "enum", "values": ["relative", "absolute"], "default": "relative" },
        "follow": { "type": "enum", "values": ["none", "entity"], "default": "none" },
        "follow_selector": { "type": "string", "default": "@p" },
        "look_at": { "type": "enum", "values": ["none", "coordinate", "entity"], "default": "none" },
        "look_at_selector": { "type": "string", "default": "@p" },
        "look_at_target_x": { "type": "float" },
        "look_at_target_y": { "type": "float" },
        "look_at_target_z": { "type": "float" },
        "look_at_target_structure": { "type": "string", "default": "" },
        "look_at_target": { "type": "map" },
        "yaw_base": { "type": "enum", "values": ["world", "entity", "line"], "default": "world" },
        "pitch_base": { "type": "enum", "values": ["world", "entity", "line"], "default": "world" },
        "yaw_base_selector": { "type": "string", "default": "@p" },
        "yaw_base_from": { "type": "string", "default": "" },
        "yaw_base_to": { "type": "string", "default": "" },
        "yaw": { "type": "float", "default": 0 },
        "pitch": { "type": "float", "default": 0 },
        "roll": { "type": "float", "default": 0 },
        "fov": { "type": "float", "default": 70 },
        "zoom": { "type": "float", "default": 1.0 }
      }
    },
    "LETTERBOX": {
      "clips": {},
      "keyframes": {
        "aspect_ratio": { "type": "float", "default": 2.35 }
      }
    },
    "AUDIO": {
      "clips": {
        "sound": { "type": "string", "required": true },
        "source": { "type": "enum", "values": ["file", "minecraft"], "default": "file" },
        "volume": { "type": "float", "default": 1.0 },
        "pitch": { "type": "float", "default": 1.0 },
        "loop": { "type": "bool", "default": false },
        "fade_in": { "type": "float", "default": 0 },
        "fade_out": { "type": "float", "default": 0 },
        "attenuation": { "type": "enum", "values": ["none", "linear", "inverse"], "default": "linear" },
        "position_mode": { "type": "enum", "values": ["relative", "absolute"], "default": "relative" },
        "category": { "type": "enum", "values": ["music", "ambient"], "default": "music" }
      },
      "keyframes": {
        "volume": { "type": "float", "default": 1.0 },
        "x": { "type": "float", "default": 0 },
        "y": { "type": "float", "default": 0 },
        "z": { "type": "float", "default": 0 }
      }
    },
    "EVENT": {
      "clips": {
        "event_type": { "type": "string", "default": "command" }
      },
      "keyframes": {
        "event_type": { "type": "string", "default": "command" },
        "command": { "type": "string", "default": "" },
        "position": { "type": "map" }
      }
    },
    "MOD_EVENT": {
      "clips": {
        "event_type": { "type": "string", "required": true },
        "data": { "type": "map" }
      },
      "keyframes": {
        "event_type": { "type": "string", "default": "mod_event" },
        "data": { "type": "map" }
      }
    },
    "OVERLAY": {
      "clips": {
        "layer_type": { "type": "enum", "values": ["fade", "image", "subtitle", "pip"], "required": true, "default": "fade" },
        "color": { "type": "string", "default": "#000000" },
        "path": { "type": "string", "default": "" },
        "text": { "type": "string", "default": "" },
        "z_index": { "type": "int", "default": 20 },
        "interpolation": { "type": "enum", "values": ["linear", "smooth"], "default": "linear" }
      },
      "keyframes": {
        "opacity": { "type": "float", "default": 0.0 },
        "x": { "type": "float", "default": 0 },
        "y": { "type": "float", "default": 0 },
        "font_scale": { "type": "float", "default": 1 },
        "scale_x": { "type": "float", "default": 1 },
        "scale_y": { "type": "float", "default": 1 }
      }
    }
  },
  "meta": {
    "id": { "type": "string", "default": "untitled", "required": true, "section": "info" },
    "name": { "type": "string", "default": "Untitled", "required": true, "section": "info" },
    "author": { "type": "string", "default": "", "section": "info" },
    "version": { "type": "int", "default": 3, "required": true, "section": "info" },
    "description": { "type": "string", "default": "", "section": "info" },
    "dimension": { "type": "string", "default": "", "section": "info" },
    "block_keyboard": { "type": "bool", "default": true, "section": "runtime" },
    "block_mouse": { "type": "bool", "default": true, "section": "runtime" },
    "block_mob_ai": { "type": "bool", "default": false, "section": "runtime" },
    "hide_hud": { "type": "bool", "default": true, "section": "runtime" },
    "hide_arm": { "type": "tristate", "section": "runtime" },
    "suppress_bob": { "type": "tristate", "section": "runtime" },
    "hide_chat": { "type": "tristate", "section": "runtime" },
    "hide_scoreboard": { "type": "tristate", "section": "runtime" },
    "hide_action_bar": { "type": "tristate", "section": "runtime" },
    "hide_title": { "type": "tristate", "section": "runtime" },
    "hide_subtitles": { "type": "tristate", "section": "runtime" },
    "hide_hotbar": { "type": "tristate", "section": "runtime" },
    "hide_crosshair": { "type": "tristate", "section": "runtime" },
    "hide_bossbar": { "type": "tristate", "section": "runtime" },
    "hide_skip_hud": { "type": "tristate", "section": "runtime" },
    "render_player_model": { "type": "bool", "default": true, "section": "runtime" },
    "pause_when_game_paused": { "type": "bool", "default": true, "section": "runtime" },
    "interruptible": { "type": "bool", "default": true, "section": "runtime" },
    "skippable": { "type": "bool", "default": true, "section": "runtime" },
    "hold_at_end": { "type": "bool", "default": false, "section": "runtime" },
    "priority": { "type": "int", "default": 0, "section": "runtime" },
    "skip_vote_ratio": { "type": "int", "section": "runtime" }
  }
}
